# =============================================================================
# WebGrade Environment Variables
# Copy this file to .env.local and fill in every value
# NEVER commit .env.local to git
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# Standard PostgreSQL connection string. Works with any PostgreSQL host:
# local, Docker, Neon, Railway, RDS, etc.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/webgrade"

# -----------------------------------------------------------------------------
# AUTHENTICATION (NextAuth)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="[GENERATE-WITH-OPENSSL]"

# -----------------------------------------------------------------------------
# AI (Anthropic Claude)
# Get from: console.anthropic.com → API Keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-[YOUR-KEY]"

# -----------------------------------------------------------------------------
# BEHAVIORAL TRACKING (PostHog)
# Get from: app.posthog.com → Settings → Project API key
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY="phc_[YOUR-KEY]"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
POSTHOG_PERSONAL_API_KEY="phx_[YOUR-KEY]"

# -----------------------------------------------------------------------------
# BACKGROUND JOBS (Inngest)
# Get from: app.inngest.com → Settings
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY="[YOUR-EVENT-KEY]"
INNGEST_SIGNING_KEY="[YOUR-SIGNING-KEY]"

# -----------------------------------------------------------------------------
# EMAIL (Resend)
# Get from: resend.com → API Keys
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_[YOUR-KEY]"
EMAIL_FROM="alerts@webgrade.io"

# -----------------------------------------------------------------------------
# BLOB STORAGE (Vercel Blob)
# Used for out-of-band session exports — when a customer queues a big
# export, the generated CSV/XLSX is stored here and the customer gets a
# 7-day signed link via email.
# Set up: Vercel project → Storage → Create Blob store. The token is
# auto-injected as an env var on subsequent deploys.
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_[AUTO_INJECTED]"

# -----------------------------------------------------------------------------
# SMS ALERTS (Twilio) — AL-04, optional
# Get from: console.twilio.com
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="AC[YOUR-SID]"
TWILIO_AUTH_TOKEN="[YOUR-TOKEN]"
TWILIO_PHONE_NUMBER="+1[YOUR-NUMBER]"

# -----------------------------------------------------------------------------
# SEO DATA APIs (for WebOpp™)
# DataForSEO: dataforseo.com → Dashboard → API credentials
# -----------------------------------------------------------------------------
DATAFORSEO_LOGIN="[YOUR-EMAIL]"
DATAFORSEO_PASSWORD="[YOUR-PASSWORD]"

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (for GA4 import OB-03, GSC for WebOpp WO-01)
# Get from: console.cloud.google.com → Credentials
# Scopes needed: analytics.readonly, searchconsole.readonly, tagmanager.edit.containers
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="[YOUR-CLIENT-ID].apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-[YOUR-SECRET]"

# Google Ads API — required for automatic campaign spend sync
# Get developer token from: https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Only needed if using a Manager (MCC) account to access client accounts
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# -----------------------------------------------------------------------------
# TRACKING SNIPPET
# This is the public URL your snippet is served from
# In production this will be your Vercel domain
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SNIPPET_VERSION="1.0.0"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# RATE LIMITING
# Ingestion API rate limit per IP per minute
# -----------------------------------------------------------------------------
INGEST_RATE_LIMIT_PER_MINUTE="100"

# -----------------------------------------------------------------------------
# DATA RETENTION (days)
# Raw events deleted after this many days (DL-04)
# Derived insights retained permanently
# -----------------------------------------------------------------------------
DATA_RETENTION_DAYS="90"

SUPER_ADMIN_EMAILS=Mike@greatersumventures.com,Jason@greatersumventures.com,Jason.Simons@greatersumventures.com
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=Mike@greatersumventures.com,Jason@greatersumventures.com,Jason.Simons@greatersumventures.com
