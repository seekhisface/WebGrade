// =============================================================================

// DL-06: Data Processing Agreement acceptance
model DpaAcceptance {
  id         String   @id @default(cuid())
  userId     String
  siteId     String
  dpaVersion String   @default("1.0")
  acceptedAt DateTime @default(now())
  ipHash     String // Hash of IP at time of acceptance (DL-01 compliant)

  user User @relation(fields: [userId], references: [id])
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId, dpaVersion])
  @@map("dpa_acceptances")
}

// DL-04: Data retention audit log
model DataRetentionLog {
  id             String   @id @default(cuid())
  siteId         String
  deletionType   String // "session_events_90d", "page_views_90d", "offboarding"
  recordsDeleted Int
  periodCovered  String // e.g. "before 2024-12-01"
  executedAt     DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("data_retention_logs")
}
